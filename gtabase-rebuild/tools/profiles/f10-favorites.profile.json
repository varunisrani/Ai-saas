{
  "app": "gtabase.com GTA 6 section - F10 favorites & personal progress, guest view (observed 2026-11-23)",
  "baseUrl": "https://www.gtabase.com",
  "readOnly": true,
  "guard": {
    "allow": []
  },
  "browser": {
    "channel": "chromium",
    "viewport": {
      "width": 1366,
      "height": 900
    },
    "locale": "en-US",
    "timezone": "UTC"
  },
  "timeouts": {
    "action": 8000,
    "navigation": 100000,
    "settle": 5000,
    "idle": 15000
  },
  "network": {
    "include": [
      "option=com_ajax",
      "option=com_jlexcomment",
      "option=com_users"
    ],
    "block": [
      "mediavine",
      "googletagmanager",
      "google-analytics",
      "doubleclick",
      "googlesyndication",
      "amazon-adsystem",
      "addtoany",
      "facebook\\.net",
      "clarity\\.ms",
      "cloudflareinsights",
      "nel\\.cloudflare",
      "quantserve",
      "scorecardresearch",
      "adnxs",
      "pubmatic",
      "rubiconproject",
      "criteo",
      "taboola",
      "outbrain",
      "giphy",
      "/cdn-cgi/challenge-platform/",
      "youtube\\.com",
      "ytimg"
    ]
  },
  "_tokenNotes": "CSS selectors come from the original markup (allowed on the analysis side). The login modal is a Regular Labs modal wrapping the hidden #loginbox block. Never click login-submit or the social buttons. header-login/mobile-login use an ends-with match because the modal library rewrites the link to the absolute page URL + #loginbox after its first use.",
  "tokens": {
    "heading": "h1",
    "body": "body",
    "fav-button": "#wishlistButton",
    "fav-button-role": "role=button[name=\"Add To Favorites\"]",
    "compare-button": ".compare-button button",
    "login-modal": "#loginbox",
    "login-title": "#loginbox .login-header",
    "login-benefits": "#loginbox .mybase-benefits",
    "modal-close": "button[data-modals-element=\"close\"]",
    "modal-root": "[data-modals-element=\"modal\"]",
    "header-login": ".mybase-buttons.no_mobile a[href$=\"#loginbox\"]",
    "header-join": ".mybase-buttons.no_mobile a[href=\"/membership/free/\"]",
    "mobile-join-toggle": ".mybase-buttons.only_mobile button.dropdown-toggle",
    "mobile-login": ".mybase-buttons.only_mobile a[href$=\"#loginbox\"]",
    "login-discord": "#loginbox button[title=\"Login with Discord\"]",
    "login-google": "#loginbox button[title=\"Sign in with Google\"]",
    "login-username": "#loginbox input[name=\"username\"]",
    "login-password": "#loginbox input[name=\"password\"]",
    "login-remember": "#loginbox input[name=\"remember\"]",
    "login-submit": "#loginbox button[type=\"submit\"]",
    "login-links": "#loginbox .com-users-login__options a",
    "login-register": "#loginbox .com-users-login__register",
    "list-fav-control": "#wishlistButton, .wishlist-button, [aria-label*=\"avorit\" i], [title*=\"avorit\" i], [aria-label*=\"garage\" i]",
    "list-compare-toggle": "[class*=\"compare\" i] button, button[class*=\"compare\" i]",
    "map-popup": ".leaflet-popup",
    "map-popup-title": ".leaflet-popup .gtab-popup-title",
    "map-popup-buttons": ".leaflet-popup button",
    "map-fav-star": ".leaflet-popup button.gtab-popup-fav",
    "map-panel": ".gtab-submit-panel",
    "map-panel-title": ".gtab-submit-panel h3",
    "map-panel-text": ".gtab-submit-panel p",
    "map-panel-login": ".gtab-submit-panel a.gtab-submit-primary",
    "map-panel-join": ".gtab-submit-panel a.gtab-submit-secondary",
    "map-panel-close": ".gtab-submit-panel .gtab-submit-close",
    "map-personal-marker": "button.gtab-submit-open:has-text(\"Personal marker\")",
    "plan": ".osm-plan",
    "plan-title": ".osm-plan-title",
    "plan-price": ".osm-plan-price",
    "plan-recommended": ".recommended-header",
    "plan-free-features": ".osm-plan-3 .plan-feature > strong",
    "plan-vip-year-features": ".osm-plan-2 .plan-feature > strong",
    "plan-vip-month-features": ".osm-plan-1 .plan-feature > strong",
    "plan-free-favorites": ".osm-plan-3 .plan-feature:has(strong:text-is(\"Favorites\")) .subtitle",
    "plan-free-checklists": ".osm-plan-3 .plan-feature:has(strong:text-is(\"Checklists & Progress Tracker\")) .subtitle",
    "plan-free-collection": ".osm-plan-3 .plan-feature:has(strong:text-is(\"GTA 6 Collection\")) .subtitle",
    "plan-vip-map": ".osm-plan-2 .plan-feature:has(strong:text-is(\"Interactive Map Extras\")) .subtitle",
    "plan-vip-profiles": ".osm-plan-2 .plan-feature:has(strong:text-is(\"Multiple Profiles per Game\")) .subtitle",
    "table-header": "table th",
    "page-form-input": "#ja-content form input:not([type=hidden])"
  },
  "modes": {
    "vehicle": [
      "goto:/gta-6/vehicles/sunset-sanchez",
      "wait:1000"
    ],
    "weapon": [
      "goto:/gta-6/weapons/assault-rifle",
      "wait:1000"
    ],
    "animal": [
      "goto:/gta-6/animals/gray-fox",
      "wait:1000"
    ],
    "radio": [
      "goto:/gta-6/radio-stations/flash-fm",
      "wait:1000"
    ],
    "property": [
      "goto:/gta-6/properties/7th-avenue-garage",
      "wait:1000"
    ],
    "character": [
      "goto:/gta-6/characters/jason",
      "wait:1000"
    ],
    "mission": [
      "goto:/gta-6/missions/breakfast-run",
      "wait:1000"
    ],
    "map-garage": [
      "goto:/gta-6/map/#garage-003",
      "wait:5000"
    ],
    "membership": [
      "goto:/membership/",
      "wait:500"
    ]
  },
  "resets": {
    "clear": [
      "try:clear:local",
      "try:clear:session"
    ]
  },
  "macros": {
    "open-fav-prompt": [
      "click:fav-button",
      "waitfor:login-modal",
      "wait:500"
    ]
  },
  "readouts": [
    {
      "key": "url",
      "read": "url"
    },
    {
      "key": "heading",
      "read": "text:heading"
    }
  ]
}