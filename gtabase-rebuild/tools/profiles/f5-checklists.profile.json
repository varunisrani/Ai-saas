{
  "app": "gtabase.com GTA 6 section - F5 checklists & mission lists (observed 2026-11-23)",
  "baseUrl": "https://www.gtabase.com",
  "readOnly": true,
  "guard": { "allow": [] },
  "browser": { "channel": "chromium", "viewport": { "width": 1366, "height": 900 }, "locale": "en-US", "timezone": "UTC" },
  "timeouts": { "action": 8000, "navigation": 60000, "settle": 5000, "idle": 15000 },
  "network": {
    "include": ["option=com_ajax", "option=com_jlexcomment"],
    "block": ["mediavine", "googletagmanager", "google-analytics", "doubleclick", "googlesyndication", "amazon-adsystem", "addtoany", "facebook\\.net", "clarity\\.ms", "cloudflareinsights", "nel\\.cloudflare", "quantserve", "scorecardresearch", "adnxs", "pubmatic", "rubiconproject", "criteo", "taboola", "outbrain", "giphy", "/cdn-cgi/challenge-platform/", "youtube\\.com", "ytimg"]
  },
  "_tokenNotes": "CSS selectors below come from the original markup (allowed on the analysis side). Copies: the 100% page renders every requirement twice - once in the contents box (toc-*) and once in the section heading (sec-*).",
  "tokens": {
    "heading": "h1",
    "cl-box": "input[type=checkbox][data-checklist-id]",
    "cl-box-checked": "input[type=checkbox][data-checklist-id]:checked",
    "cl-box-disabled": "input[type=checkbox][data-checklist-id]:disabled",
    "cl-box-labelled": "input[type=checkbox][data-checklist-id][aria-label^=\"Mark as completed\"]",
    "pct-module": ".completion-percentage-wrapper",
    "pct-text": "#completion-percentage",
    "pct-bar": "#completion-progress-bar",
    "guest-note": ".completion-percentage-wrapper .article-info",
    "guest-note-login": ".completion-percentage-wrapper .article-info a",
    "profile-switcher": ".gtab-cl-profile",
    "reset-control": "role=button[name=/reset|untick|clear/i]",
    "toc-box": ".rl_quickindex input[type=checkbox][data-checklist-id]",
    "sec-box": ".checklist-item input[type=checkbox][data-checklist-id]",
    "toc-story": ".rl_quickindex input[id=\"story\"]",
    "sec-story": ".checklist-item input[id=\"story\"]",
    "toc-kenton": ".rl_quickindex input[id=\"kenton\"]",
    "sec-kenton": ".checklist-item input[id=\"kenton\"]",
    "sec-cards": ".checklist-item input[id=\"cards\"]",
    "sec-exploration": ".checklist-item input[id=\"exploration\"]",
    "toc-exploration": ".rl_quickindex input[id=\"exploration\"]",
    "sec-exploration-children": ".checklist-item input[data-parent-id=\"gta6-100:exploration\"]",
    "sec-exploration-children-checked": ".checklist-item input[data-parent-id=\"gta6-100:exploration\"]:checked",
    "sec-story-tasks": ".checklist-item input[id=\"story-tasks\"]",
    "sec-story-tasks-children-checked": ".checklist-item input[data-parent-id=\"gta6-100:story-tasks\"]:checked",
    "sec-optional": ".checklist-item input[id=\"optional\"]",
    "sec-gang-ops": ".checklist-item input[id=\"gang-ops\"]",
    "sec-bank-jobs": ".checklist-item input[id=\"bank-jobs\"]",
    "sec-discovery": ".checklist-item input[id=\"discovery\"]",
    "sec-vehicles": ".checklist-item input[id=\"vehicles\"]",
    "sec-weapons": ".checklist-item input[id=\"weapons\"]",
    "sec-animals": ".checklist-item input[id=\"animals\"]",
    "sec-drones": ".checklist-item input[id=\"drones\"]",
    "chapter-heading": ".category-desc > h2",
    "mission-row": "a.items-row",
    "mission-row-optional": "a.items-row.items-row--opt",
    "mission-row-main-link": "a.items-row:not(.items-row--opt)[href^=\"/gta-6/missions/\"]",
    "mission-row-strangers-link": "a.items-row[href^=\"/gta-6/strangers/\"]",
    "mission-box-first": "input[data-checklist-id=\"gta6-missions\"]",
    "mission-first-row": "a.items-row",
    "mission-gone-fishing": "input[data-checklist-id=\"gta6-missions\"][id=\"7285\"]",
    "mission-shirleys-rum": "input[data-checklist-id=\"gta6-missions\"][id=\"7291\"]",
    "mission-skunk-ape": "input[data-checklist-id=\"gta6-missions\"][id=\"7319\"]",
    "activity-card": ".category-items .items-row",
    "events-table-header": "table th",
    "events-table-cell": "table td"
  },
  "modes": {
    "hub": "/gta-6/",
    "checklist100": ["goto:/articles/gta-6/gta-6-100-completion-guide-interactive-checklist", "wait:1500"],
    "missions": ["goto:/gta-6/missions/", "wait:1500"],
    "strangers": ["goto:/gta-6/strangers-missions/", "wait:1500"],
    "side-missions": ["goto:/gta-6/side-missions/", "wait:1500"],
    "random-events": ["goto:/gta-6/random-events/", "wait:2500"]
  },
  "resets": { "clear": ["try:clear:local", "try:clear:session"] },
  "macros": {
    "tick-all-exploration": ["click:sec-kenton", "click:sec-cards", "click:.checklist-item input[id=\"waink\"]", "click:.checklist-item input[id=\"underwater\"]", "click:.checklist-item input[id=\"magazines\"]", "click:.checklist-item input[id=\"meditation\"]", "click:.checklist-item input[id=\"flamingos\"]", "click:.checklist-item input[id=\"playlists\"]", "click:.checklist-item input[id=\"styles\"]", "click:.checklist-item input[id=\"races\"]", "click:.checklist-item input[id=\"race-challenges\"]", "click:.checklist-item input[id=\"shooting\"]", "click:.checklist-item input[id=\"video-games\"]", "click:.checklist-item input[id=\"pool\"]", "click:.checklist-item input[id=\"mini-golf\"]", "click:.checklist-item input[id=\"basketball\"]", "click:.checklist-item input[id=\"drones\"]", "click:.checklist-item input[id=\"stunts\"]", "click:.checklist-item input[id=\"challenges\"]", "click:.checklist-item input[id=\"target-decks\"]"]
  },
  "readouts": [
    { "key": "url", "read": "url" },
    { "key": "heading", "read": "text:heading" }
  ]
}
