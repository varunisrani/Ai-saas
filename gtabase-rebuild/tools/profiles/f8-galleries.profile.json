{
  "app": "gtabase.com GTA 6 section (observed 2026-11-23) - F8 media galleries",
  "baseUrl": "https://www.gtabase.com",
  "readOnly": true,
  "guard": { "allow": [] },
  "browser": {
    "channel": "chromium",
    "viewport": { "width": 1366, "height": 900 },
    "locale": "en-US",
    "timezone": "UTC",
    "args": ["--disable-blink-features=AutomationControlled"],
    "_note_args": "navigator.webdriver=false so JCH Optimize loads the interaction-deferred Ignite Gallery scripts (ignitegallery-42.js, lib-42.js) as for a real visitor"
  },
  "timeouts": { "action": 8000, "navigation": 60000, "settle": 5000, "idle": 15000 },
  "network": {
    "include": ["option=com_igallery", "option=com_ajax"],
    "block": ["mediavine", "googletagmanager", "google-analytics", "doubleclick", "googlesyndication", "amazon-adsystem", "addtoany", "facebook\\.net", "clarity\\.ms", "cloudflareinsights", "nel\\.cloudflare", "quantserve", "scorecardresearch", "adnxs", "pubmatic", "rubiconproject", "criteo", "taboola", "outbrain", "giphy", "/cdn-cgi/challenge-platform/", "task=imagefront\\.(addHit|addRating|addComment|download)"]
  },
  "tokens": {
    "_note": "CSS taken from the original markup (analysis side only)",
    "heading": "h1",
    "media-tab": ".flex-buttons a",
    "media-tab-active": ".flex-buttons a.active",
    "media-tab-trailers": ".flex-buttons a[href=\"/gta-6/screenshots/trailers/\"]",
    "media-tab-artworks": ".flex-buttons a[href=\"/gta-6/artworks/\"]",
    "media-tab-videos": ".flex-buttons a[href=\"/gta-6/videos/\"]",
    "gallery": ".ig-gallery-wrapper",
    "gallery-heading": ".com-content-article__body h2",
    "thumb": ".ig-scroller-img-wrapper",
    "thumb-img": ".ig-scroller-img",
    "thumb-img-lazy": ".ig-scroller-img[loading=\"lazy\"]",
    "thumb-1": ":nth-match(.ig-scroller-img-wrapper .ig-img-link, 1)",
    "thumb-3": ":nth-match(.ig-scroller-img-wrapper .ig-img-link, 3)",
    "thumb-5": ":nth-match(.ig-scroller-img-wrapper .ig-img-link, 5)",
    "thumb-1-img": ":nth-match(.ig-scroller-img, 1)",
    "g1-thumb": ":nth-match(.ig-gallery-wrapper, 1) .ig-scroller-img-wrapper",
    "g2-thumb": ":nth-match(.ig-gallery-wrapper, 2) .ig-scroller-img-wrapper",
    "g3-thumb": ":nth-match(.ig-gallery-wrapper, 3) .ig-scroller-img-wrapper",
    "g2-thumb-1": ":nth-match(.ig-gallery-wrapper, 2) .ig-img-link >> nth=0",
    "g1-thumb-2": ":nth-match(.ig-gallery-wrapper, 1) .ig-img-link >> nth=1",
    "g1-thumb-2-active": ":nth-match(.ig-gallery-wrapper, 1) li.ig-scroller-img-wrapper.ig-active-thumb >> nth=0",
    "g1-active-thumb": ":nth-match(.ig-gallery-wrapper, 1) li.ig-scroller-img-wrapper.ig-active-thumb",
    "g1-active-thumb-img": ":nth-match(.ig-gallery-wrapper, 1) li.ig-scroller-img-wrapper.ig-active-thumb img",
    "g1-main-active": ":nth-match(.ig-gallery-wrapper, 1) .ig-slideshow-item.igui-active .ig-slideshow-item-inner-lboxon",
    "g1-main-active-img": ":nth-match(.ig-gallery-wrapper, 1) .ig-slideshow-item.igui-active img",
    "g1-main-next": ":nth-match(.ig-gallery-wrapper, 1) .ig-slideshow-button-right",
    "main-image": ".ig-slideshow-item.igui-active .ig-slideshow-item-inner-lboxon",
    "main-slideshow": ".ig-slideshow",
    "image-description": ".ig-image-description",
    "lightbox": ".igui-lightbox.igui-open",
    "lb-counter": ".igui-lightbox.igui-open .ig-img-numbering",
    "lb-total": ".igui-lightbox.igui-open .ig-image-total",
    "lb-next": ".igui-lightbox.igui-open a[aria-label=\"next\"]",
    "lb-prev": ".igui-lightbox.igui-open a[aria-label=\"previous\"]",
    "lb-close": ".igui-lightbox.igui-open button[aria-label=\"close\"]",
    "lb-caption": ".igui-lightbox.igui-open .ig-lightbox-descriptions",
    "lb-image": ".igui-lightbox.igui-open .igui-lightbox-items li.igui-active img",
    "lb-loaded-image": ".igui-lightbox.igui-open .igui-lightbox-items li img",
    "lb-slot": ".igui-lightbox.igui-open .igui-lightbox-items li",
    "lb-bottom": ".igui-lightbox.igui-open .ig-lightbox-bottom-wrapper",
    "lb-toolbar-action": ".igui-lightbox.igui-open .ig-lbox-button",
    "lb-download": ".igui-lightbox.igui-open .ig-download-button",
    "page-scroll-lock": "html.igui-lightbox-page",
    "pagination": "form.ig-thumb-pagination",
    "pagination-item": ":nth-match(form.ig-thumb-pagination, 1) li.page-item",
    "pagination-active": ":nth-match(form.ig-thumb-pagination, 1) li.page-item.active",
    "pagination-disabled": ":nth-match(form.ig-thumb-pagination, 1) li.page-item.disabled",
    "pagination-page-2": ":nth-match(form.ig-thumb-pagination, 1) a[aria-label=\"Go to page 2\"]",
    "pagination-next": ":nth-match(form.ig-thumb-pagination, 1) a[aria-label=\"Go to next page\"]",
    "pagination-last": ":nth-match(form.ig-thumb-pagination, 1) a[aria-label=\"Go to last page\"]",
    "modal-trigger": "[data-modals]",
    "modal-trigger-login": "[data-modals][href=\"#loginbox\"]",
    "video-embed": "iframe, .youtube-play, img[src*=\"youtube-play\"]"
  },
  "modes": {
    "shots": ["goto:/gta-6/screenshots/", "macro:wake"],
    "trailers": ["goto:/gta-6/screenshots/trailers/", "macro:wake"],
    "artworks": ["goto:/gta-6/artworks/", "macro:wake"],
    "covers": ["goto:/gta-6/covers/", "macro:wake"],
    "maploc": ["goto:/gta-6/map-locations/", "macro:wake"]
  },
  "resets": { "clear": ["try:clear:local", "try:clear:session"] },
  "macros": {
    "wake": ["hover:heading", "wait:3000", "wait:idle"],
    "open-first": ["click:thumb-1", "waitfor:lb-counter", "wait:700"]
  },
  "readouts": [
    { "key": "url", "read": "url" },
    { "key": "heading", "read": "text:heading" }
  ]
}
