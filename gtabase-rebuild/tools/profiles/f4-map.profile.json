{
  "app": "gtabase.com GTA 6 section (observed 2026-11-23) - F4 interactive map",
  "baseUrl": "https://www.gtabase.com",
  "readOnly": true,
  "guard": {
    "allow": []
  },
  "browser": {
    "channel": "chromium",
    "viewport": {
      "width": 1366,
      "height": 900
    },
    "locale": "en-US",
    "timezone": "UTC"
  },
  "timeouts": {
    "action": 8000,
    "navigation": 60000,
    "settle": 5000,
    "idle": 15000
  },
  "network": {
    "include": [
      "/media/com_jamegafilter/",
      "option=com_ajax",
      "option=com_jlexcomment",
      "/search"
    ],
    "block": [
      "mediavine",
      "googletagmanager",
      "google-analytics",
      "doubleclick",
      "googlesyndication",
      "amazon-adsystem",
      "addtoany",
      "facebook\\.net",
      "clarity\\.ms",
      "cloudflareinsights",
      "nel\\.cloudflare",
      "quantserve",
      "scorecardresearch",
      "adnxs",
      "pubmatic",
      "rubiconproject",
      "criteo",
      "taboola",
      "outbrain",
      "giphy",
      "/cdn-cgi/challenge-platform/",
      "youtube\\.com",
      "ytimg"
    ]
  },
  "_tokens_note": "CSS selectors below are taken from the original markup (analysis side only); role= selectors use the accessible names recorded in evidence/traces/f4-map.md.",
  "tokens": {
    "heading": "h1",
    "map-root": "#gtab-map",
    "sidebar": "#gtab-map .gtab-sidebar",
    "sidebar-close": "role=button[name=\"Hide the sidebar\"]",
    "sidebar-open": "#gtab-map .gtab-sidebar-toggle-button",
    "guest-line": "#gtab-map .gtab-guest-line",
    "login-link": "#gtab-map .gtab-guest-line a",
    "search-input": "role=combobox[name=\"Search locations or categories\"]",
    "search-clear": "role=button[name=\"Clear the search\"]",
    "search-hits": "#gtab-search-results [role=option]",
    "search-hit-first": "#gtab-search-hit-0",
    "search-empty": "#gtab-map .gtab-search-empty",
    "category-none": "#gtab-map .gtab-filter-none",
    "group-rail": "nav[aria-label=\"Groups\"] button",
    "rail-robberies": "nav[aria-label=\"Groups\"] button[aria-label=\"Robberies\"]",
    "rail-food": "nav[aria-label=\"Groups\"] button[aria-label=\"Food & Drink\"]",
    "show-hide-all": "#gtab-map .gtab-filter-all:not(.gtab-filter-found)",
    "hide-found": "#gtab-map .gtab-filter-found",
    "groups": "#gtab-map .gtab-filter-group",
    "category-rows": "#gtab-map .gtab-filter-row",
    "category-rows-visible": "#gtab-map .gtab-filter-row:visible",
    "category-rows-tracked": "#gtab-map .gtab-filter-row.gtab-filter-row-tracked",
