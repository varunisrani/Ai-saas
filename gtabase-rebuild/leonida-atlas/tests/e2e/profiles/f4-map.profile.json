 "modes": {
  "map": [
   "goto:about:blank",
   "goto:/gta-6/map/",
   "waitfor:map-zoom-in",
   "wait:1500"
  ],
  "map-mobile": [
   "viewport:390x844",
   "goto:about:blank",
   "goto:/gta-6/map/",
   "waitfor:map-zoom-in",
   "wait:1500"
  ],
  "start-marker": [
   "goto:about:blank",
   "goto:/gta-6/map/#safehouse-001",
   "waitfor:popup-title",
   "wait:1000"
  ]
 },
 "resets": {
  "clear": [
   "try:clear:local",
   "try:clear:session",
   "viewport:1366x900"
  ],
  "desktop": [
   "viewport:1366x900"
  ]
 },
 "macros": {
  "ready": [
   "waitfor:map-zoom-in",
   "wait:1200"
  ],
  "tick-start": [
   "goto:about:blank",
   "goto:/gta-6/map/#safehouse-001",
   "waitfor:popup-found-toggle",
   "wait:800",
   "click:popup-found-toggle",
   "wait:700"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "blocked",
   "read": "blocked"
  }
 ]
}