{
 "app": "Leonida Atlas (rebuild) \u2014 vectors for suite f8-galleries",
 "baseUrl": "http://localhost:3000",
 "readOnly": false,
 "browser": {
  "channel": "chromium",
  "viewport": {
   "width": 1366,
   "height": 900
  },
  "locale": "en-US",
  "timezone": "UTC"
 },
 "timeouts": {
  "action": 6000,
  "navigation": 30000,
  "settle": 3000,
  "idle": 8000
 },
 "tokens": {
  "_note": "[data-testid=\"_note\"]",
  "heading": "h1",
  "media-tab": "[data-testid=\"media-tab\"]",
  "media-tab-active": "[data-testid=\"media-tab-active\"]",
  "media-tab-trailers": "[data-testid=\"media-tab-trailers\"]",
  "media-tab-artworks": "[data-testid=\"media-tab-artworks\"]",
  "media-tab-videos": "[data-testid=\"media-tab-videos\"]",
  "gallery": "[data-testid=\"gallery\"]",
  "gallery-heading": "[data-testid=\"gallery-heading\"]",
  "thumb": "[data-testid=\"thumb\"]",
  "thumb-img": "[data-testid=\"thumb-img\"]",
  "thumb-img-lazy": "[data-testid=\"thumb-img-lazy\"]",
  "thumb-1": "[data-testid=\"thumb-1\"]",
  "thumb-3": "[data-testid=\"thumb-3\"]",
  "thumb-5": "[data-testid=\"thumb-5\"]",
  "thumb-1-img": "[data-testid=\"thumb-1-img\"]",
  "g1-thumb": "[data-testid=\"g1-thumb\"]",
  "g2-thumb": "[data-testid=\"g2-thumb\"]",
  "g3-thumb": "[data-testid=\"g3-thumb\"]",
  "g2-thumb-1": "[data-testid=\"g2-thumb-1\"]",
  "g1-thumb-2": "[data-testid=\"g1-thumb-2\"]",
  "g1-thumb-2-active": "[data-testid=\"g1-thumb-2-active\"]",
  "g1-active-thumb": "[data-testid=\"g1-active-thumb\"]",
  "g1-active-thumb-img": "[data-testid=\"g1-active-thumb-img\"]",
  "g1-main-active": "[data-testid=\"g1-main-active\"]",
  "g1-main-active-img": "[data-testid=\"g1-main-active-img\"]",
  "g1-main-next": "[data-testid=\"g1-main-next\"]",
  "main-image": "[data-testid=\"main-image\"]",
  "main-slideshow": "[data-testid=\"main-slideshow\"]",
  "image-description": "[data-testid=\"image-description\"]",
  "lightbox": "[data-testid=\"lightbox\"]",
  "lb-counter": "[data-testid=\"lb-counter\"]",
  "lb-total": "[data-testid=\"lb-total\"]",
  "lb-next": "[data-testid=\"lb-next\"]",
  "lb-prev": "[data-testid=\"lb-prev\"]",
  "lb-close": "[data-testid=\"lb-close\"]",
  "lb-caption": "[data-testid=\"lb-caption\"]",
  "lb-image": "[data-testid=\"lb-image\"]",
  "lb-loaded-image": "[data-testid=\"lb-loaded-image\"]",
  "lb-slot": "[data-testid=\"lb-slot\"]",
  "lb-bottom": "[data-testid=\"lb-bottom\"]",
  "lb-toolbar-action": "[data-testid=\"lb-toolbar-action\"]",
  "lb-download": "[data-testid=\"lb-download\"]",
  "page-scroll-lock": "[data-testid=\"page-scroll-lock\"]",
  "pagination": "[data-testid=\"pagination\"]",
  "pagination-item": "[data-testid=\"pagination-item\"]",
  "pagination-active": "[data-testid=\"pagination-active\"]",
  "pagination-disabled": "[data-testid=\"pagination-disabled\"]",
  "pagination-page-2": "[data-testid=\"pagination-page-2\"]",
  "pagination-next": "[data-testid=\"pagination-next\"]",
  "pagination-last": "[data-testid=\"pagination-last\"]",
  "modal-trigger": "[data-testid=\"modal-trigger\"]",
  "modal-trigger-login": "[data-testid=\"modal-trigger-login\"]",
  "video-embed": "[data-testid=\"video-embed\"]",
  "thumb-100": "[data-testid=\"thumb-100\"]"
 },
 "modes": {
  "shots": [
   "goto:/gta-6/screenshots/",
   "macro:wake"
  ],
  "trailers": [
   "goto:/gta-6/screenshots/trailers/",
   "macro:wake"
  ],
  "artworks": [
   "goto:/gta-6/artworks/",
   "macro:wake"
  ],
  "covers": [
   "goto:/gta-6/covers/",
   "macro:wake"
  ],
  "maploc": [
   "goto:/gta-6/map-locations/",
   "macro:wake"
  ]
 },
 "resets": {
  "clear": [
   "try:clear:local",
   "try:clear:session"
  ]
 },
 "macros": {
  "wake": [
   "hover:heading",
   "wait:3000",
   "wait:idle",
   "hover:thumb-img",
   "wait:3000"
  ],
  "open-first": [
   "click:thumb-1",
   "waitfor:lb-counter",
   "wait:700"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "heading",
   "read": "text:heading"
  }
 ]
}