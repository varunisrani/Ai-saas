{
 "app": "Leonida Atlas (rebuild) \u2014 vectors for suite f10-favorites",
 "baseUrl": "http://localhost:3000",
 "readOnly": false,
 "browser": {
  "channel": "chromium",
  "viewport": {
   "width": 1366,
   "height": 900
  },
  "locale": "en-US",
  "timezone": "UTC"
 },
 "timeouts": {
  "action": 6000,
  "navigation": 30000,
  "settle": 3000,
  "idle": 8000
 },
 "tokens": {
  "heading": "h1",
  "body": "[data-testid=\"body\"]",
  "fav-button": "[data-testid=\"fav-button\"]",
  "fav-button-role": "[data-testid=\"fav-button-role\"]",
  "compare-button": "[data-testid=\"compare-button\"]",
  "login-modal": "[data-testid=\"login-modal\"]",
  "login-title": "[data-testid=\"login-title\"]",
  "login-benefits": "[data-testid=\"login-benefits\"]",
  "modal-close": "[data-testid=\"modal-close\"]",
  "modal-root": "[data-testid=\"modal-root\"]",
  "header-login": "[data-testid=\"header-login\"]",
  "header-join": "[data-testid=\"header-join\"]",
  "mobile-join-toggle": "[data-testid=\"mobile-join-toggle\"]",
  "mobile-login": "[data-testid=\"mobile-login\"]",
  "login-discord": "[data-testid=\"login-discord\"]",
  "login-google": "[data-testid=\"login-google\"]",
  "login-username": "[data-testid=\"login-username\"]",
  "login-password": "[data-testid=\"login-password\"]",
  "login-remember": "[data-testid=\"login-remember\"]",
  "login-submit": "[data-testid=\"login-submit\"]",
  "login-links": "[data-testid=\"login-links\"]",
  "login-register": "[data-testid=\"login-register\"]",
  "list-fav-control": "[data-testid=\"list-fav-control\"]",
  "list-compare-toggle": "[data-testid=\"list-compare-toggle\"]",
  "map-popup": "[data-testid=\"map-popup\"]",
  "map-popup-title": "[data-testid=\"map-popup-title\"]",
  "map-popup-buttons": "[data-testid=\"map-popup-buttons\"]",
  "map-fav-star": "[data-testid=\"map-fav-star\"]",
  "map-panel": "[data-testid=\"map-panel\"]",
  "map-panel-title": "[data-testid=\"map-panel-title\"]",
  "map-panel-text": "[data-testid=\"map-panel-text\"]",
  "map-panel-login": "[data-testid=\"map-panel-login\"]",
  "map-panel-join": "[data-testid=\"map-panel-join\"]",
  "map-panel-close": "[data-testid=\"map-panel-close\"]",
  "map-personal-marker": "[data-testid=\"map-personal-marker\"]",
  "plan": "[data-testid=\"plan\"]",
  "plan-title": "[data-testid=\"plan-title\"]",
  "plan-price": "[data-testid=\"plan-price\"]",
  "plan-recommended": "[data-testid=\"plan-recommended\"]",
  "plan-free-features": "[data-testid=\"plan-free-features\"]",
  "plan-vip-year-features": "[data-testid=\"plan-vip-year-features\"]",
  "plan-vip-month-features": "[data-testid=\"plan-vip-month-features\"]",
  "plan-free-favorites": "[data-testid=\"plan-free-favorites\"]",
  "plan-free-checklists": "[data-testid=\"plan-free-checklists\"]",
  "plan-free-collection": "[data-testid=\"plan-free-collection\"]",
  "plan-vip-map": "[data-testid=\"plan-vip-map\"]",
  "plan-vip-profiles": "[data-testid=\"plan-vip-profiles\"]",
  "table-header": "[data-testid=\"table-header\"]",
  "page-form-input": "[data-testid=\"page-form-input\"]"
 },
 "modes": {
  "vehicle": [
   "goto:/gta-6/vehicles/sunset-sanchez",
   "wait:1000"
  ],
  "weapon": [
   "goto:/gta-6/weapons/assault-rifle",
   "wait:1000"
  ],
  "animal": [
   "goto:/gta-6/animals/gray-fox",
   "wait:1000"
  ],
  "radio": [
   "goto:/gta-6/radio-stations/flash-fm",
   "wait:1000"
  ],
  "property": [
   "goto:/gta-6/properties/7th-avenue-garage",
   "wait:1000"
  ],
  "character": [
   "goto:/gta-6/characters/jason",
   "wait:1000"
  ],
  "mission": [
   "goto:/gta-6/missions/breakfast-run",
   "wait:1000"
  ],
  "map-garage": [
   "goto:/gta-6/map/#garage-003",
   "wait:5000"
  ],
  "membership": [
   "goto:/membership/",
   "wait:500"
  ]
 },
 "resets": {
  "clear": [
   "try:clear:local",
   "try:clear:session"
  ]
 },
 "macros": {
  "open-fav-prompt": [
   "click:fav-button",
   "waitfor:login-modal",
   "wait:500"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "heading",
   "read": "text:heading"
  }
 ]
}