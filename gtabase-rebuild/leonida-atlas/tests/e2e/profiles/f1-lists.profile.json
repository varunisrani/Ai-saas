  "manufacturer-search": "[data-testid~=\"manufacturer-search\"]",
  "manufacturer-results": "[data-testid~=\"manufacturer-results\"]",
  "manufacturer-options": "[data-testid~=\"manufacturer-options\"]",
  "standout-select": "[data-testid~=\"standout-select\"]",
  "standout-dropdown": "[data-testid~=\"standout-dropdown\"]",
  "standout-shown": "[data-testid~=\"standout-shown\"]",
  "standout-results": "[data-testid~=\"standout-results\"]",
  "standout-option-hide": "[data-testid~=\"standout-option-hide\"]",
  "standout-option-2": "[data-testid~=\"standout-option-2\"]",
