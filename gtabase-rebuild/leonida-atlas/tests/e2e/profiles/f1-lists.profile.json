  "weapon-type-options": "[data-testid~=\"weapon-type-options\"]",
  "weapon-type-option-unique": "[data-testid~=\"weapon-type-option-unique\"]",
  "sort-select": "[data-testid~=\"sort-select\"]",
  "sort-options": "[data-testid~=\"sort-options\"]",
  "sort-dropdown": "[data-testid~=\"sort-dropdown\"]",
  "sort-shown": "[data-testid~=\"sort-shown\"]",
  "sort-option-name": "[data-testid~=\"sort-option-name\"]",
  "sort-option-manufacturer": "[data-testid~=\"sort-option-manufacturer\"]",
  "sort-option-class": "[data-testid~=\"sort-option-class\"]",
  "sort-option-speed": "[data-testid~=\"sort-option-speed\"]",
  "sort-option-seats": "[data-testid~=\"sort-option-seats\"]",
  "sort-option-damage": "[data-testid~=\"sort-option-damage\"]",
  "sort-direction": "[data-testid~=\"sort-direction\"]",
  "clear-filters": "[data-testid~=\"clear-filters\"]",
  "selected-filters": "[data-testid~=\"selected-filters\"]",
  "filters-toggle": "[data-testid~=\"filters-toggle\"]",
  "filter-panel": "[data-testid~=\"filter-panel\"]",
  "filter-panel-content": "[data-testid~=\"filter-panel-content\"]",
  "filter-backdrop": "[data-testid~=\"filter-backdrop\"]",
  "layout-list": "[data-testid~=\"layout-list\"]",
  "layout-grid": "[data-testid~=\"layout-grid\"]",
  "products-wrapper": "[data-testid~=\"products-wrapper\"]",
  "list-head": "[data-testid~=\"list-head\"]",
  "megafilter-wrap": "[data-testid~=\"megafilter-wrap\"]",
  "mission-row-text": "[data-testid~=\"mission-row-text\"]",
  "walkthrough-box": "[data-testid~=\"walkthrough-box\"]"
 },
 "modes": {
  "hub": "/gta-6/",
  "vehicles": [
   "goto:/gta-6/vehicles/",
   "waitfor:card",
   "wait:600"
  ],
  "weapons": [
   "goto:/gta-6/weapons/",
   "waitfor:card",
   "wait:600"
  ]
 },
 "resets": {
  "clear": [
   "try:keyup:Control",
   "try:clear:local",
   "try:clear:session",
   "try:viewport:1366x900"
  ]
 },
 "macros": {
  "fresh": [
   "goto:about:blank"
  ],
  "hide-standouts": [
   "click:standout-dropdown",
   "click:standout-option-hide",
   "wait:700"
  ],
  "sort-by-name": [
   "click:sort-dropdown",
   "click:sort-option-name",
   "wait:700"
  ],
  "flip-direction": [
   "click:sort-direction",
   "wait:700"
  ],
  "load-next-page": [
   "scroll:autopage-sentinel",
   "wait:900"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "count",
   "read": "text:list-count-number"
  },
  {
   "key": "cards",
   "read": "count:card"
  }
 ]
}