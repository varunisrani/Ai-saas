  "name-search": "[data-testid~=\"name-search\"]",
  "real-life-search": "[data-testid~=\"real-life-search\"]",
  "class-options": "[data-testid~=\"class-options\"]",
  "class-checked": "[data-testid~=\"class-checked\"]",
  "class-empty": "[data-testid~=\"class-empty\"]",
  "class-1": "[data-testid~=\"class-1\"]",
  "class-super": "[data-testid~=\"class-super\"]",
  "class-super-box": "[data-testid~=\"class-super-box\"]",
  "class-sports": "[data-testid~=\"class-sports\"]",
