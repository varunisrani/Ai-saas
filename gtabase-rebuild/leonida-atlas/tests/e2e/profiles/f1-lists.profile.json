{
 "app": "Leonida Atlas (rebuild) \u2014 vectors for suite f1-lists",
 "baseUrl": "http://localhost:3000",
 "readOnly": false,
 "browser": {
  "channel": "chromium",
  "viewport": {
   "width": 1366,
   "height": 900
  },
  "locale": "en-US",
  "timezone": "UTC"
 },
 "timeouts": {
  "action": 6000,
  "navigation": 30000,
  "settle": 3000,
  "idle": 8000
 },
 "tokens": {
  "heading": "h1",
  "list-count": "[data-testid~=\"list-count\"]",
  "list-count-number": "[data-testid~=\"list-count-number\"]",
  "list-count-bottom-number": "[data-testid~=\"list-count-bottom-number\"]",
