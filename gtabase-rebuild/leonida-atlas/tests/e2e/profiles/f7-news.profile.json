{
 "app": "Leonida Atlas (rebuild) \u2014 vectors for suite f7-news",
 "baseUrl": "http://localhost:3000",
 "readOnly": false,
 "browser": {
  "channel": "chromium",
  "viewport": {
   "width": 1366,
   "height": 900
  },
  "locale": "en-US",
  "timezone": "UTC"
 },
 "timeouts": {
  "action": 6000,
  "navigation": 30000,
  "settle": 3000,
  "idle": 8000
 },
 "tokens": {
  "heading": "h1",
  "page-number": "[data-testid=\"page-number\"]",
  "list-intro": "[data-testid=\"list-intro\"]",
  "list-banner": "[data-testid=\"list-banner\"]",
  "list-item": "[data-testid=\"list-item\"]",
  "item-title-link": "[data-testid=\"item-title-link\"]",
  "item-thumb": "[data-testid=\"item-thumb\"]",
  "item-thumb-link": "[data-testid=\"item-thumb-link\"]",
  "item-details-label": "[data-testid=\"item-details-label\"]",
  "item-author": "[data-testid=\"item-author\"]",
  "item-date": "[data-testid=\"item-date\"]",
  "item-category": "[data-testid=\"item-category\"]",
  "item-tags": "[data-testid=\"item-tags\"]",
  "parent-category": "[data-testid=\"parent-category\"]",
  "share-block": "[data-testid=\"share-block\"]",
  "share-buttons": "[data-testid=\"share-buttons\"]",
  "game-filter-toggle": "[data-testid=\"game-filter-toggle\"]",
  "game-filter-menu": "[data-testid=\"game-filter-menu\"]",
  "game-filter-links": "[data-testid=\"game-filter-links\"]",
  "game-filter-gta6": "[data-testid=\"game-filter-gta6\"]",
  "page-counter": "[data-testid=\"page-counter\"]",
  "pagination": "[data-testid=\"pagination\"]",
  "page-links": "[data-testid=\"page-links\"]",
  "page-current": "[data-testid=\"page-current\"]",
  "page-disabled": "[data-testid=\"page-disabled\"]",
  "page-first": "[data-testid=\"page-first\"]",
  "page-prev": "[data-testid=\"page-prev\"]",
  "page-next": "[data-testid=\"page-next\"]",
  "page-last": "[data-testid=\"page-last\"]",
  "page-2-link": "[data-testid=\"page-2-link\"]",
  "article-meta": "[data-testid=\"article-meta\"]",
  "article-author": "[data-testid=\"article-author\"]",
  "article-published": "[data-testid=\"article-published\"]",
  "article-modified": "[data-testid=\"article-modified\"]",
  "article-category": "[data-testid=\"article-category\"]",
  "article-hero": "[data-testid=\"article-hero\"]",
  "toc": "[data-testid=\"toc\"]",
  "toc-heading": "[data-testid=\"toc-heading\"]",
  "toc-links": "[data-testid=\"toc-links\"]",
  "toc-link-3": "[data-testid=\"toc-link-3\"]",
  "section-anchors": "[data-testid=\"section-anchors\"]",
  "section-headings": "[data-testid=\"section-headings\"]",
  "video-embed": "[data-testid=\"video-embed\"]",
  "author-block": "[data-testid=\"author-block\"]",
  "pager": "[data-testid=\"pager\"]",
  "pager-prev": "[data-testid=\"pager-prev\"]",
  "pager-next": "[data-testid=\"pager-next\"]",
  "related-block": "[data-testid=\"related-block\"]",
  "related-heading": "[data-testid=\"related-heading\"]",
  "related-cards": "[data-testid=\"related-cards\"]",
  "breadcrumbs": "[data-testid=\"breadcrumbs\"]",
  "breadcrumb-items": "[data-testid=\"breadcrumb-items\"]",
  "comments": "[data-testid=\"comments\"]",
  "comments-count": "[data-testid=\"comments-count\"]",
  "comment-sort-options": "[data-testid=\"comment-sort-options\"]",
  "comment-sort-current": "[data-testid=\"comment-sort-current\"]",
  "comment-editor": "[data-testid=\"comment-editor\"]",
  "comment-limit": "[data-testid=\"comment-limit\"]",
  "sidebar": "[data-testid=\"sidebar\"]",
  "footer": "[data-testid=\"footer\"]",
  "article-end": "[data-testid=\"article-end\"]"
 },
 "modes": {
  "news": "/gta-6/news/",
  "guides": "/gta-6/guides/",
  "videos": "/gta-6/videos/",
  "allnews": "/news/",
  "article": "/gta-6/articles/gta-6-driving-tips",
  "controls": "/articles/gta-6/gta-6-controls-guide-ps5-xbox-button-layout",
  "video-article": "/articles/gta-6/grand-theft-auto-vi-launch-trailer",
  "news-phone": [
   "viewport:390x844",
   "goto:/gta-6/news/"
  ],
  "article-phone": [
   "viewport:390x844",
   "goto:/gta-6/articles/gta-6-driving-tips"
  ]
 },
 "resets": {
  "clear": [
   "viewport:1366x900",
   "try:clear:local",
   "try:clear:session"
  ]
 },
 "macros": {
  "to-bottom": [
   "press:End",
   "wait:1500",
   "press:End",
   "wait:1000"
  ],
  "show-pagination": [
   "scroll:page-counter",
   "wait:1500"
  ],
  "show-pager": [
   "scroll:article-end",
   "wait:1500"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "heading",
   "read": "text:heading"
  }
 ]
}