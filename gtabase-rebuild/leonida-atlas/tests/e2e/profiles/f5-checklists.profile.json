  "a.items-row[href=\"/missions/gta-6/prologue\"] .mission-description": "[data-testid~=\"mission-row-text\"]",
  "h2.checklist-item input[data-checklist-id=\"gta6-missions\"]": "[data-testid~=\"walkthrough-box\"]"
 },
 "modes": {
  "hub": "/gta-6/",
  "checklist100": [
   "goto:/articles/gta-6/gta-6-100-completion-guide-interactive-checklist",
   "wait:1500"
  ],
  "missions": [
   "goto:/gta-6/missions/",
   "wait:1500"
  ],
  "strangers": [
   "goto:/gta-6/strangers-missions/",
   "wait:1500"
  ],
  "side-missions": [
   "goto:/gta-6/side-missions/",
   "wait:1500"
  ],
  "random-events": [
   "goto:/gta-6/random-events/",
   "wait:2500"
  ]
 },
 "resets": {
  "clear": [
   "try:clear:local",
   "try:clear:session"
  ]
 },
 "macros": {
  "tick-all-exploration": [
   "click:sec-kenton",
   "click:sec-cards",
   "click:.checklist-item input[id=\"waink\"]",
   "click:.checklist-item input[id=\"underwater\"]",
   "click:.checklist-item input[id=\"magazines\"]",
   "click:.checklist-item input[id=\"meditation\"]",
   "click:.checklist-item input[id=\"flamingos\"]",
   "click:.checklist-item input[id=\"playlists\"]",
   "click:.checklist-item input[id=\"styles\"]",
   "click:.checklist-item input[id=\"races\"]",
   "click:.checklist-item input[id=\"race-challenges\"]",
   "click:.checklist-item input[id=\"shooting\"]",
   "click:.checklist-item input[id=\"video-games\"]",
   "click:.checklist-item input[id=\"pool\"]",
   "click:.checklist-item input[id=\"mini-golf\"]",
   "click:.checklist-item input[id=\"basketball\"]",
   "click:.checklist-item input[id=\"drones\"]",
   "click:.checklist-item input[id=\"stunts\"]",
   "click:.checklist-item input[id=\"challenges\"]",
   "click:.checklist-item input[id=\"target-decks\"]"
  ]
 },
 "readouts": [
  {
   "key": "url",
   "read": "url"
  },
  {
   "key": "heading",
   "read": "text:heading"
  }
 ]
}