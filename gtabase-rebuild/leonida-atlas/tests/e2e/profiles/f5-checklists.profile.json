{
 "app": "Leonida Atlas (rebuild) \u2014 vectors for suite f5-checklists",
 "baseUrl": "http://localhost:3000",
 "readOnly": false,
 "browser": {
  "channel": "chromium",
  "viewport": {
   "width": 1366,
   "height": 900
  },
  "locale": "en-US",
  "timezone": "UTC"
 },
 "timeouts": {
  "action": 6000,
  "navigation": 30000,
  "settle": 3000,
  "idle": 8000
 },
 "tokens": {
  "heading": "h1",
  "cl-box": "[data-testid~=\"cl-box\"]",
  "cl-box-checked": "[data-testid~=\"cl-box-checked\"]",
  "cl-box-disabled": "[data-testid~=\"cl-box-disabled\"]",
