  "mission-gone-fishing": "[data-testid~=\"mission-gone-fishing\"]",
  "mission-shirleys-rum": "[data-testid~=\"mission-shirleys-rum\"]",
  "mission-skunk-ape": "[data-testid~=\"mission-skunk-ape\"]",
  "activity-card": "[data-testid~=\"activity-card\"]",
  "events-table-header": "[data-testid~=\"events-table-header\"]",
  "events-table-cell": "[data-testid~=\"events-table-cell\"]",
  "mission-row-text": "[data-testid~=\"mission-row-text\"]",
  "walkthrough-box": "[data-testid~=\"walkthrough-box\"]",
  ".checklist-item input[id=\"waink\"]": "[data-testid~=\"sec-waink\"]",
