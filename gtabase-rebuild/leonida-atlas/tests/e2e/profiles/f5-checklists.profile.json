  "toc-story": "[data-testid~=\"toc-story\"]",
  "sec-story": "[data-testid~=\"sec-story\"]",
  "toc-kenton": "[data-testid~=\"toc-kenton\"]",
  "sec-kenton": "[data-testid~=\"sec-kenton\"]",
  "sec-cards": "[data-testid~=\"sec-cards\"]",
  "sec-exploration": "[data-testid~=\"sec-exploration\"]",
  "toc-exploration": "[data-testid~=\"toc-exploration\"]",
  "sec-exploration-children": "[data-testid~=\"sec-exploration-children\"]",
  "sec-exploration-children-checked": "[data-testid~=\"sec-exploration-children-checked\"]",
  "sec-story-tasks": "[data-testid~=\"sec-story-tasks\"]",
  "sec-story-tasks-children-checked": "[data-testid~=\"sec-story-tasks-children-checked\"]",
  "sec-optional": "[data-testid~=\"sec-optional\"]",
  "sec-gang-ops": "[data-testid~=\"sec-gang-ops\"]",
  "sec-bank-jobs": "[data-testid~=\"sec-bank-jobs\"]",
  "sec-discovery": "[data-testid~=\"sec-discovery\"]",
  "sec-vehicles": "[data-testid~=\"sec-vehicles\"]",
  "sec-weapons": "[data-testid~=\"sec-weapons\"]",
  "sec-animals": "[data-testid~=\"sec-animals\"]",
  "sec-drones": "[data-testid~=\"sec-drones\"]",
  "chapter-heading": "[data-testid~=\"chapter-heading\"]",
  "mission-row": "[data-testid~=\"mission-row\"]",
  "mission-row-optional": "[data-testid~=\"mission-row-optional\"]",
  "mission-row-main-link": "[data-testid~=\"mission-row-main-link\"]",
